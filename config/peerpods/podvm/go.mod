module podvm-tools

go 1.25.11

// Note: yq/v4 requires go.yaml.in/yaml/v4 v4.0.0-rc.4 (pre-release).
// yaml/v4 has no stable release - it's been in RC for years but is production-ready.
// This is intentional and expected; yq v4 is designed for yaml v4.
tool (
	github.com/mikefarah/yq/v4
	github.com/opencontainers/umoci/cmd/umoci
	github.com/openshift/oc/cmd/oc
)

replace github.com/apcera/gssapi => github.com/openshift/gssapi v0.0.0-20161010215902-5fb4217df13b

