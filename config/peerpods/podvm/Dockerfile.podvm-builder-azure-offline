# OSC 1.11 podvm-builder image
ARG BASE_BUILDER_IMAGE=registry.redhat.io/openshift-sandboxed-containers/osc-podvm-builder-rhel9@sha256:9efde29746c28defaabce25c2f0c6da7567ca7dc7fe97845886d7d9e750ea094

FROM ${BASE_BUILDER_IMAGE}

# This derived image pre-installs Azure dependencies for offline/air-gapped environments
# The base image already contains scripts and generic RPMs

# Install Azure dependencies (CLI and binaries) at build time
RUN /scripts/azure-podvm-image-handler.sh -- install_cli && \
    /scripts/azure-podvm-image-handler.sh -- install_binaries

# Override only the labels that differ from base image
LABEL name="openshift-sandboxed-containers/osc-podvm-builder-azure-offline" \
com.redhat.component="osc-podvm-builder-azure-offline-container" \
summary="Pre-configured container image with Azure dependencies for creating Pod VM images" \
description="Container image with Azure dependencies pre-installed for creating Pod VM images in offline/air-gapped environments" \
io.k8s.display-name="openshift-sandboxed-containers-podvm-builder-azure-offline" \
io.k8s.description="Pre-configured container image with Azure dependencies for creating Pod VM images" \
io.openshift.tags="azure,offline"
