#!/bin/bash

source /usr/bin/gather_common

IFS=$'\n'

OSC_PATH=${BASE_COLLECTION_PATH}/sandboxed-containers
mkdir -p ${OSC_PATH}

operator_resources=()
operator_resources+=(kataconfig)
operator_resources+=(clusterserviceversion)
operator_resources+=(subscription)
operator_resources+=(services)

for operator_resource in "${operator_resources[@]}"; do
	oc describe ${operator_resource} -n openshift-sandboxed-containers-operator > "${OSC_PATH}/${operator_resource}_description"
done

# NOTE Jul 16, 2021: a single one is expected as of this writing, with more
# possibly being added in the future
KATA_WEBHOOK_CONFIGS=$(oc get validatingwebhookconfigurations -A -o'custom-columns=name:metadata.name' --no-headers | grep kata)
oc describe validatingwebhookconfigurations ${KATA_WEBHOOK_CONFIGS} > "${OSC_PATH}/validatingwebhookconfigurations_description"


# operators
operators=()
#  logs from everything in the following operators namespaces
#  - openshift-sandboxed-containers-operator
#  - openshift-machine-config-operator
operators+=(openshift-sandboxed-containers-operator)
operators+=(openshift-machine-config-operator)

NAMESPACE_PATH=${OSC_PATH}/namespaces
for operator in "${operators[@]}"; do
    OPERATOR_NS=${NAMESPACE_PATH}/${operator}
    mkdir -p ${OPERATOR_NS}

    for pod in $(oc get pods -n "${operator}" -o'custom-columns=name:metadata.name' --no-headers); do
        oc logs "${pod}" --all-containers -n "${operator}" > "${OPERATOR_NS}/${pod}_logs"
    done
done

# mcps — skip on HCP hosted clusters where MachineConfigPools do not exist
detect_topology
if [[ "$IS_HCP" == "true" ]]; then
    echo "HCP hosted cluster detected, skipping MachineConfigPool collection"
else
    mcps=()
    mcps+=(master)
    mcps+=(worker)
    mcps+=(kata-oc)

    MCP_PATH=${OSC_PATH}/mcps
    mkdir -p ${MCP_PATH}

    for mcp in "${mcps[@]}"; do
        if oc get mcp "${mcp}" &>/dev/null; then
            oc describe mcp "${mcp}" > "${MCP_PATH}/${mcp}_description"
        fi
    done
fi

# installplans — YAML collected in the OLM diagnostics section below

# marketplace
MARKETPLACE_NS=${NAMESPACE_PATH}/openshift-marketplace
mkdir -p ${MARKETPLACE_NS}

for pod in $(oc get pods -n openshift-marketplace -o'custom-columns=name:metadata.name' --no-headers); do
    oc logs "${pod}" --all-containers -n openshift-marketplace > "${MARKETPLACE_NS}/${pod}_logs"
    oc describe pod "${pod}" -n openshift-marketplace > "${MARKETPLACE_NS}/${pod}_description"
done

# lifecycle-manager
LIFECYCLE_MANAGER_NS=${LIFECYCLE_MANAGER_NS}/openshift-operator-lifecycle-manager
mkdir -p ${LIFECYCLE_MANAGER_NS}

for pod in $(oc get pods -n openshift-operator-lifecycle-manager -o'custom-columns=name:metadata.name' --no-headers); do
    oc logs "${pod}" --all-containers -n openshift-operator-lifecycle-manager > "${LIFECYCLE_MANAGER_NS}/${pod}_logs"
    oc describe pod "${pod}" -n openshift-operator-lifecycle-manager > "${LIFECYCLE_MANAGER_NS}/${pod}_description"
done

# sandboxed containers operator deployment resources

DEPLOYMENT_UNIT_PATH=${NAMESPACE_PATH}/openshift-sandboxed-containers-operator/deployments
mkdir -p ${DEPLOYMENT_UNIT_PATH}

deploymentUnits=(pods deployments statefulsets deploymentconfigs)

for deploymentUnit in "${deploymentUnits[@]}"; do
	echo "$deploymentUnit using kata runtime class still running:"

	oc get $deploymentUnit -A -o json | jq -r '.items[] | select(.spec.runtimeClassName | test("kata")).metadata.name' 2>/dev/null > ${DEPLOYMENT_UNIT_PATH}/${deploymentUnit}

done

# peer-pods resources
PEERPODS_PATH=${OSC_PATH}/peer-pods
mkdir -p ${PEERPODS_PATH}

echo "Collecting peer-pods resources..."

OSC_NS="openshift-sandboxed-containers-operator"
CCO_NS="openshift-cloud-credential-operator"

collect_resource "Collecting peer-pods-cm ConfigMap" \
    "${PEERPODS_PATH}/peer-pods-cm.yaml" \
    run_oc get configmap peer-pods-cm -n "${OSC_NS}" -o yaml

# peer-pods-secret — key names only (not values) for security
if oc get secret peer-pods-secret -n "${OSC_NS}" &>/dev/null; then
    collect_resource "Collecting peer-pods-secret key names" \
        "${PEERPODS_PATH}/peer-pods-secret-keys.txt" \
        run_oc get secret peer-pods-secret -n "${OSC_NS}" -o go-template='{{range $k, $v := .data}}{{$k}}{{"\n"}}{{end}}'
fi

collect_resource "Collecting peerpodconfig CR" \
    "${PEERPODS_PATH}/peerpodconfig.yaml" \
    run_oc get peerpodconfig -n "${OSC_NS}" -o yaml

# PodVMImageJob resources — status, conditions
for podvmimagejob in $(oc get podvmimagejob -n "${OSC_NS}" -o'custom-columns=name:metadata.name' --no-headers 2>/dev/null); do
    collect_resource "Collecting PodVMImageJob ${podvmimagejob}" \
        "${PEERPODS_PATH}/${podvmimagejob}.yaml" \
        run_oc get podvmimagejob "${podvmimagejob}" -n "${OSC_NS}" -o yaml
    collect_resource "Describing PodVMImageJob ${podvmimagejob}" \
        "${PEERPODS_PATH}/${podvmimagejob}_description" \
        run_oc describe podvmimagejob "${podvmimagejob}" -n "${OSC_NS}"
done

# cloud-credentials secret structure (key names only)
if oc get secret cloud-credentials -n "${OSC_NS}" &>/dev/null; then
    collect_resource "Collecting cloud-credentials key names" \
        "${PEERPODS_PATH}/cloud-credentials-keys.txt" \
        run_oc get secret cloud-credentials -n "${OSC_NS}" -o go-template='{{range $k, $v := .data}}{{$k}}{{"\n"}}{{end}}'
fi

# OLM diagnostics
OLM_PATH=${OSC_PATH}/olm
mkdir -p ${OLM_PATH}

echo "Collecting OLM diagnostics..."

collect_resource "Collecting CatalogSources" \
    "${OLM_PATH}/catalogsources.yaml" \
    run_oc get catalogsource -n openshift-marketplace -o yaml

collect_resource "Collecting OperatorGroup" \
    "${OLM_PATH}/operatorgroup.yaml" \
    run_oc get operatorgroup -n "${OSC_NS}" -o yaml

# InstallPlan — collect both YAML and description in a single loop
for installplan in $(oc get installplans -n "${OSC_NS}" -o'custom-columns=name:metadata.name' --no-headers 2>/dev/null); do
    collect_resource "Collecting InstallPlan ${installplan}" \
        "${OLM_PATH}/${installplan}.yaml" \
        run_oc get installplan "${installplan}" -n "${OSC_NS}" -o yaml
    collect_resource "Describing InstallPlan ${installplan}" \
        "${NAMESPACE_PATH}/openshift-sandboxed-containers-operator/${installplan}_description" \
        run_oc describe installplan "${installplan}" -n "${OSC_NS}"
done

collect_resource "Collecting CredentialsRequests" \
    "${OLM_PATH}/credentialsrequests.yaml" \
    run_oc get credentialsrequest -n "${CCO_NS}" -o yaml

collect_resource "Collecting controller manager deployments" \
    "${OLM_PATH}/deployments.yaml" \
    run_oc get deployment -n "${OSC_NS}" -o yaml
