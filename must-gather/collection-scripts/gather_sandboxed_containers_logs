#!/bin/bash

IFS=$'\n'

BASE_COLLECTION_PATH="/must-gather"

OSC_PATH=${BASE_COLLECTION_PATH}/sandboxed-containers
mkdir -p ${OSC_PATH}

operator_resources=()
operator_resources+=(kataconfig)
operator_resources+=(clusterserviceversion)
operator_resources+=(subscription)
operator_resources+=(services)

for operator_resource in "${operator_resources[@]}"; do
	oc describe ${operator_resource} -n openshift-sandboxed-containers-operator > "${OSC_PATH}/${operator_resource}_description"
done

# NOTE Jul 16, 2021: a single one is expected as of this writing, with more
# possibly being added in the future
KATA_WEBHOOK_CONFIGS=$(oc get validatingwebhookconfigurations -A -o'custom-columns=name:metadata.name' --no-headers | grep kata)
oc describe validatingwebhookconfigurations ${KATA_WEBHOOK_CONFIGS} > "${OSC_PATH}/validatingwebhookconfigurations_description"


# operators
operators=()
#  logs from everything in the following operators namespaces
#  - openshift-sandboxed-containers-operator
#  - openshift-machine-config-operator
operators+=(openshift-sandboxed-containers-operator)
operators+=(openshift-machine-config-operator)

NAMESPACE_PATH=${OSC_PATH}/namespaces
for operator in "${operators[@]}"; do
    OPERATOR_NS=${NAMESPACE_PATH}/${operator}
    mkdir -p ${OPERATOR_NS}

    for pod in $(oc get pods -n "${operator}" -o'custom-columns=name:metadata.name' --no-headers); do
        oc logs "${pod}" --all-containers -n "${operator}" > "${OPERATOR_NS}/${pod}_logs"
    done
done

# mcps — skip on HCP hosted clusters where MachineConfigPools do not exist
TOPOLOGY=$(oc get infrastructure cluster -o jsonpath='{.status.controlPlaneTopology}' 2>/dev/null)
if [[ "$TOPOLOGY" == "External" ]]; then
    echo "HCP hosted cluster detected, skipping MachineConfigPool collection"
else
    mcps=()
    mcps+=(master)
    mcps+=(worker)
    mcps+=(kata-oc)

    MCP_PATH=${OSC_PATH}/mcps
    mkdir -p ${MCP_PATH}

    for mcp in "${mcps[@]}"; do
        if oc get mcp "${mcp}" &>/dev/null; then
            oc describe mcp "${mcp}" > "${MCP_PATH}/${mcp}_description"
        fi
    done
fi

# installplans
INSTALLPLAN_NS=${NAMESPACE_PATH}/openshift-sandboxed-containers-operator
mkdir -p ${INSTALLPLAN_NS}

for installplan in $(oc get installplans -n openshift-sandboxed-containers-operator -o'custom-columns=name:metadata.name' --no-headers); do
    oc describe installplan ${installplan} -n openshift-sandboxed-containers-operator > "${INSTALLPLAN_NS}/${installplan}_description"
done

# marketplace
MARKETPLACE_NS=${NAMESPACE_PATH}/openshift-marketplace
mkdir -p ${MARKETPLACE_NS}

for pod in $(oc get pods -n openshift-marketplace -o'custom-columns=name:metadata.name' --no-headers); do
    oc logs "${pod}" --all-containers -n openshift-marketplace > "${MARKETPLACE_NS}/${pod}_logs"
    oc describe pod "${pod}" -n openshift-marketplace > "${MARKETPLACE_NS}/${pod}_description"
done

# lifecycle-manager
LIFECYCLE_MANAGER_NS=${LIFECYCLE_MANAGER_NS}/openshift-operator-lifecycle-manager
mkdir -p ${LIFECYCLE_MANAGER_NS}

for pod in $(oc get pods -n openshift-operator-lifecycle-manager -o'custom-columns=name:metadata.name' --no-headers); do
    oc logs "${pod}" --all-containers -n openshift-operator-lifecycle-manager > "${LIFECYCLE_MANAGER_NS}/${pod}_logs"
    oc describe pod "${pod}" -n openshift-operator-lifecycle-manager > "${LIFECYCLE_MANAGER_NS}/${pod}_description"
done

# sandboxed containers operator deployment resources

DEPLOYMENT_UNIT_PATH=${NAMESPACE_PATH}/openshift-sandboxed-containers-operator/deployments
mkdir -p ${DEPLOYMENT_UNIT_PATH}

deploymentUnits=(pods deployments statefulsets deploymentconfigs)

for deploymentUnit in "${deploymentUnits[@]}"; do
	echo "$deploymentUnit using kata runtime class still running:"

	oc get $deploymentUnit -A -o json | jq -r '.items[] | select(.spec.runtimeClassName | test("kata")).metadata.name' 2>/dev/null > ${DEPLOYMENT_UNIT_PATH}/${deploymentUnit}

done

# peer-pods resources
PEERPODS_PATH=${OSC_PATH}/peer-pods
mkdir -p ${PEERPODS_PATH}

echo "Collecting peer-pods resources..."

# peer-pods-cm ConfigMap — contains VPC, subnet, security group, AMI/image ID, region
oc get configmap peer-pods-cm -n openshift-sandboxed-containers-operator -o yaml > "${PEERPODS_PATH}/peer-pods-cm.yaml" 2>/dev/null

# peer-pods-secret — key names only (not values) for security
if oc get secret peer-pods-secret -n openshift-sandboxed-containers-operator &>/dev/null; then
	oc get secret peer-pods-secret -n openshift-sandboxed-containers-operator -o jsonpath='{.data}' 2>/dev/null | jq 'keys' > "${PEERPODS_PATH}/peer-pods-secret-keys.json" 2>/dev/null
fi

# peerpodconfig CR
oc get peerpodconfig -n openshift-sandboxed-containers-operator -o yaml > "${PEERPODS_PATH}/peerpodconfig.yaml" 2>/dev/null

# PodVMImageJob resources — status, conditions
for podvmimagejob in $(oc get podvmimagejob -n openshift-sandboxed-containers-operator -o'custom-columns=name:metadata.name' --no-headers 2>/dev/null); do
	oc get podvmimagejob "${podvmimagejob}" -n openshift-sandboxed-containers-operator -o yaml > "${PEERPODS_PATH}/${podvmimagejob}.yaml" 2>/dev/null
	oc describe podvmimagejob "${podvmimagejob}" -n openshift-sandboxed-containers-operator > "${PEERPODS_PATH}/${podvmimagejob}_description" 2>/dev/null
done

# cloud-credentials secret structure (key names only)
if oc get secret cloud-credentials -n openshift-sandboxed-containers-operator &>/dev/null; then
	oc get secret cloud-credentials -n openshift-sandboxed-containers-operator -o jsonpath='{.data}' 2>/dev/null | jq 'keys' > "${PEERPODS_PATH}/cloud-credentials-keys.json" 2>/dev/null
fi

# OLM diagnostics
OLM_PATH=${OSC_PATH}/olm
mkdir -p ${OLM_PATH}

echo "Collecting OLM diagnostics..."

# CatalogSource resources (YAML, not just pod logs)
oc get catalogsource -n openshift-marketplace -o yaml > "${OLM_PATH}/catalogsources.yaml" 2>/dev/null

# OperatorGroup in the OSC namespace
oc get operatorgroup -n openshift-sandboxed-containers-operator -o yaml > "${OLM_PATH}/operatorgroup.yaml" 2>/dev/null

# InstallPlan status with conditions
for installplan in $(oc get installplans -n openshift-sandboxed-containers-operator -o'custom-columns=name:metadata.name' --no-headers 2>/dev/null); do
	oc get installplan ${installplan} -n openshift-sandboxed-containers-operator -o yaml > "${OLM_PATH}/${installplan}.yaml" 2>/dev/null
done

# CredentialsRequests in the operator namespace
oc get credentialsrequest -n openshift-sandboxed-containers-operator -o yaml > "${OLM_PATH}/credentialsrequests.yaml" 2>/dev/null

# Controller manager deployment status
oc get deployment -n openshift-sandboxed-containers-operator -o yaml > "${OLM_PATH}/deployments.yaml" 2>/dev/null
