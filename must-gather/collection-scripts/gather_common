#!/bin/bash

# Shared error handling and utility functions for must-gather collection scripts.
# Source this file at the top of each gather_* script:
#   source /usr/bin/gather_common

# Base output directory. Overridable via the environment (used by tests).
BASE_COLLECTION_PATH="${BASE_COLLECTION_PATH:-/must-gather}"

# Error tracking
ERROR_LOG="${BASE_COLLECTION_PATH}/must-gather-errors.log"
ERROR_COUNT=0

# Initialize error log (only once — check if already initialized)
if [[ ! -f "$ERROR_LOG" ]]; then
    echo "Must-gather error log - $(date)" > "$ERROR_LOG"
    echo "======================================" >> "$ERROR_LOG"
    echo "" >> "$ERROR_LOG"
fi

# Log error helper function
# Redacts node names, pod names, and IP addresses to avoid exposing internal identifiers
log_error() {
    local context="$1"
    local command="$2"
    local exit_code="$3"
    local output="$4"

    ((ERROR_COUNT++))

    # Redact node and pod names from context and command
    local redacted_context=$(echo "$context" | sed -E 's/(node|pod) [a-zA-Z0-9._-]+/\1 <redacted>/g')
    local redacted_command=$(echo "$command" | sed -E 's/(node|pod)-[a-zA-Z0-9._-]+/<\1-name>/g')

    # Redact sensitive data from output: hostnames, IP addresses, pod/node names
    local redacted_output=""
    if [[ -n "$output" ]]; then
        redacted_output=$(echo "$output" | \
            sed -E 's/[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/<ipv4-address>/g' | \
            sed -E 's/([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}/<ipv6-address>/g' | \
            sed -E 's/(node|pod)-[a-zA-Z0-9._-]+/<\1-name>/g' | \
            sed -E 's/\.cluster\.local/<cluster-domain>/g')
    fi

    {
        echo "ERROR #${ERROR_COUNT} at $(date)"
        echo "Context: $redacted_context"
        echo "Command: $redacted_command"
        echo "Exit Code: $exit_code"
        if [[ -n "$redacted_output" ]]; then
            echo "Output (redacted):"
            echo "$redacted_output"
        fi
        echo "---"
        echo ""
    } >> "$ERROR_LOG"
}

# Wrapper for oc: logs the command with a timestamp, provides a single
# place to inject additional arguments (e.g. --request-timeout).
# Safe to pass to exec_with_retry/collect_resource as the command: shell
# functions are handled by exec_with_timeout, and the log line is surfaced
# on stderr even when the call succeeds.
run_oc() {
    echo "$(date '+%H:%M:%S') oc $*" >&2
    oc "$@"
}

# Execute a command under timeout(1).
#
# timeout(1) can only launch executables, not shell functions such as
# run_oc (KATA-6493: "timeout: failed to run command 'run_oc'"). When the
# command names a shell function, export it and run it through an explicit
# "bash -c" subshell so that timeout(1) has an executable to launch.
# timeout(1) signals the child's process group, so commands spawned by the
# function are still terminated when the timeout expires.
#
# Note: a function run this way must only call external commands, or other
# shell functions that are explicitly exported before the call.
exec_with_timeout() {
    local timeout_secs="$1"
    shift

    if declare -F "$1" >/dev/null 2>&1; then
        local func="$1"
        shift
        # shellcheck disable=SC2163 # the function named by $func is exported
        export -f "${func?}"
        timeout "$timeout_secs" bash -c "$func \"\$@\"" "$func" "$@"
    else
        timeout "$timeout_secs" "$@"
    fi
}

# Execute a command with retry logic.
# Stdout and stderr are kept separate: only stdout is returned on success,
# so command warnings do not contaminate collected output files.
# The command may be an executable or a shell function (e.g. run_oc); see
# exec_with_timeout.
# EXEC_MAX_RETRIES, EXEC_RETRY_DELAY and EXEC_TIMEOUT_SECS override the
# defaults; they exist primarily so tests can exercise the logic quickly.
exec_with_retry() {
    local max_retries="${EXEC_MAX_RETRIES:-3}"
    local retry_delay="${EXEC_RETRY_DELAY:-2}"
    local timeout_secs="${EXEC_TIMEOUT_SECS:-30}"
    local attempt=1
    local output
    local exit_code
    local stderr_file
    stderr_file=$(mktemp 2>/dev/null || echo "/tmp/exec_retry_stderr_$$")

    while [[ $attempt -le $max_retries ]]; do
        output=$(exec_with_timeout "$timeout_secs" "$@" 2>"$stderr_file")
        exit_code=$?

        # Surface the attempt's stderr (command logs such as run_oc
        # timestamps, warnings) so it is not silently dropped when the
        # command succeeds. It is kept in the error log on failure via the
        # callers, which capture this function's stderr.
        cat "$stderr_file" >&2

        if [[ $exit_code -eq 0 ]]; then
            echo "$output"
            rm -f "$stderr_file"
            return 0
        fi

        if [[ $exit_code -eq 124 ]] && [[ $attempt -lt $max_retries ]]; then
            echo "Timeout on attempt $attempt, retrying..." >&2
            sleep "$retry_delay"
            ((attempt++))
            ((retry_delay *= 2))
            continue
        fi

        if [[ $attempt -lt $max_retries ]]; then
            sleep "$retry_delay"
            ((attempt++))
            continue
        fi

        # All retries exhausted
        echo "$output"
        rm -f "$stderr_file"
        return "$exit_code"
    done

    rm -f "$stderr_file"
    return "$exit_code"
}

# Run a command, log errors on failure, write output to a file on success.
# Usage: collect_resource "context description" "output_file" command [args...]
collect_resource() {
    local context="$1"
    local output_file="$2"
    shift 2

    local output
    local exit_code
    local stderr_file
    stderr_file=$(mktemp 2>/dev/null || echo "/tmp/collect_resource_stderr_$$")

    output=$(exec_with_retry "$@" 2>"$stderr_file")
    exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        local stderr_content
        stderr_content=$(<"$stderr_file")
        log_error "$context" "$*" "$exit_code" "${output}${stderr_content:+$'\n'$stderr_content}"
        rm -f "$stderr_file"
        return "$exit_code"
    fi

    rm -f "$stderr_file"
    if [[ -n "$output" ]]; then
        echo "$output" > "$output_file"
    fi
    return 0
}

# Detect HCP topology. Sets CONTROL_PLANE_TOPOLOGY and IS_HCP:
#   IS_HCP=true  — controlPlaneTopology is External (HCP hosted cluster)
#   IS_HCP=false — standalone cluster (any other controlPlaneTopology value)
#   IS_HCP=""    — topology unknown (the query failed)
# Callers must treat an unknown topology conservatively and collect both
# HCP-specific and standalone diagnostics rather than silently skipping
# either (KATA-6493: a failed detection used to imply IS_HCP=true, which
# skipped MachineConfigPool collection on standalone clusters).
detect_topology() {
    if [[ -n "$CONTROL_PLANE_TOPOLOGY" ]]; then
        return
    fi
    local topology
    local exit_code
    local stderr_file
    local stderr_content
    stderr_file=$(mktemp 2>/dev/null || echo "/tmp/detect_topology_stderr_$$")
    # Capture the exit status directly: "if ! cmd; then ... $?" would always
    # see the negated status (0), losing the real failure/timeout code in
    # the error log.
    topology=$(exec_with_retry run_oc get infrastructure cluster -o jsonpath='{.status.controlPlaneTopology}' 2>"$stderr_file")
    exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        stderr_content=$(<"$stderr_file")
        log_error "Detecting cluster topology (controlPlaneTopology)" \
                  "run_oc get infrastructure cluster -o jsonpath={.status.controlPlaneTopology}" \
                  "$exit_code" \
                  "${topology}${stderr_content:+$'\n'$stderr_content}"
        rm -f "$stderr_file"
        CONTROL_PLANE_TOPOLOGY=""
        IS_HCP=""
        return 0
    fi
    rm -f "$stderr_file"
    CONTROL_PLANE_TOPOLOGY="$topology"
    if [[ "$CONTROL_PLANE_TOPOLOGY" == "External" ]]; then
        IS_HCP=true
    else
        IS_HCP=false
    fi
}

# Redact the value of every "Token" JSON field in the *.json files under a
# directory, recursively.
#
# kata/virtcontainers sandbox state (nodes/<node>/run/vc/sbs/*/*/persist.json)
# contains the runtime token of the sandbox process in its "Process" object.
# The value has no diagnostic value, and leaktk flags the whole must-gather
# archive when it finds it (KATA-6494), so it is replaced with a placeholder
# in the gathered copies after collection. The field itself and everything
# else in the files is preserved.
#
# The replacement is done by a small JSON-aware scanner: it tracks strings
# and escape sequences, so it also copes with values containing escaped
# quotes, any capitalization of the field name, and a value placed on a
# separate line from the key. Field names are matched after \uXXXX escape
# decoding, so escaped spellings of the name are caught as well. Bytes
# unrelated to the redaction are copied verbatim.
#
# The function fails closed: it returns non-zero when the file list cannot
# be collected or when any file cannot be processed or replaced, so callers
# must drop the data instead of packaging unredacted tokens.
#
# Usage: redact_token_fields <directory>
redact_token_fields() {
    local dir="$1"
    local file
    local list
    local trailing_newline
    local tmp_out
    local rc=0

    # A missing directory means nothing was collected; that is not an error.
    if [[ ! -d "$dir" ]]; then
        return 0
    fi

    # Collect the file list up front: iterating over a process substitution
    # would silently drop find's exit status and hide traversal failures.
    list=$(mktemp 2>/dev/null) || list="/tmp/redact_token_files_$$"
    if ! find "$dir" -type f -name '*.json' -print0 >"$list"; then
        rm -f "$list"
        return 1
    fi

    while IFS= read -r -d '' file; do
        # awk line processing drops the newline of the last record; tell the
        # scanner whether the file had one so the output stays byte-identical
        # apart from the redacted values.
        if [[ -n "$(tail -c 1 "$file" 2>/dev/null)" ]]; then
            trailing_newline=0
        else
            trailing_newline=1
        fi
        # A unique temporary name in the same directory: a fixed
        # "${file}.redacting" could clobber an unrelated collected file
        # that happens to carry that name.
        tmp_out=$(mktemp "${file}.redacting.XXXXXX") || { rc=1; continue; }
        if ! awk -v trailing_newline="$trailing_newline" '
            # Replace the string value of every "token" field (key matched
            # case-insensitively, after \uXXXX escape decoding) with
            # <redacted>, copying everything else verbatim. States:
            # 0 normal, 1 after a "token" key string, 2 after the colon,
            # waiting for the value string.
            function ws(c) { return c == " " || c == "\t" || c == "\r" || c == "\n" }
            # Decode \uXXXX escapes for the field-name comparison only;
            # the emitted text keeps the original bytes. ASCII only: the
            # names we match are ASCII, and %c for non-ASCII code points
            # is locale-dependent (gawk in a C locale emits the low byte,
            # which could make an unrelated field falsely match).
            function decode(s,    out, i, c, h, k, d, v, ok, n) {
                out = ""
                n = length(s)
                i = 1
                while (i <= n) {
                    c = substr(s, i, 1)
                    if (c == "\\" && substr(s, i + 1, 1) == "u" && i + 5 <= n) {
                        h = substr(s, i + 2, 4)
                        ok = 1
                        v = 0
                        for (k = 1; k <= 4; k++) {
                            d = index("0123456789abcdef", tolower(substr(h, k, 1)))
                            if (d < 1) { ok = 0; break }
                            v = v * 16 + d - 1
                        }
                        if (ok && v < 128) {
                            out = out sprintf("%c", v)
                            i = i + 6
                            continue
                        }
                    }
                    out = out c
                    i = i + 1
                }
                return out
            }
            {
                if (NR > 1) buf = buf "\n"
                buf = buf $0
            }
            END {
                if (trailing_newline && NR > 0) buf = buf "\n"
                n = length(buf)
                i = 1
                while (i <= n) {
                    c = substr(buf, i, 1)
                    if (state == 1) {
                        if (c == ":") { printf "%s", c; state = 2; i++; continue }
                        if (ws(c))   { printf "%s", c; i++; continue }
                        state = 0
                    } else if (state == 2) {
                        if (ws(c)) { printf "%s", c; i++; continue }
                        if (c == "\"") {
                            i++
                            esc = 0
                            while (i <= n) {
                                d = substr(buf, i, 1)
                                if (esc)            { esc = 0 }
                                else if (d == "\\") { esc = 1 }
                                else if (d == "\"") { break }
                                i++
                            }
                            printf "\"<redacted>\""
                            state = 0
                            i++
                            continue
                        }
                        state = 0
                    }
                    if (c == "\"") {
                        i++
                        s = ""
                        esc = 0
                        while (i <= n) {
                            d = substr(buf, i, 1)
                            if (esc)            { s = s d; esc = 0 }
                            else if (d == "\\") { s = s d; esc = 1 }
                            else if (d == "\"") { break }
                            else                { s = s d }
                            i++
                        }
                        j = i + 1
                        while (j <= n && ws(substr(buf, j, 1))) { j++ }
                        if (substr(buf, j, 1) == ":" && tolower(decode(s)) == "token") {
                            state = 1
                        }
                        printf "\"%s\"", s
                        i++
                        continue
                    }
                    printf "%s", c
                    i++
                }
            }
        ' "$file" >"$tmp_out"; then
            rm -f "$tmp_out"
            rc=1
            continue
        fi
        if ! mv "$tmp_out" "$file"; then
            rm -f "$tmp_out"
            rc=1
        fi
    done <"$list"
    rm -f "$list"
    return "$rc"
}

# Collect the kata/virtcontainers runtime state (/host/run/vc) from a
# node-gather pod and publish it under <vc_path>, with the sandbox process
# tokens redacted (see redact_token_fields).
#
# The data is staged outside the collection tree (under /tmp) and only
# published after the copy succeeded and the redaction was verified, so a
# failure of the copy, the redaction, the publish or the cleanup itself can
# never put unredacted runtime data into the archive (KATA-6494). A failed
# copy drops the data entirely: whatever it leaves behind is partial and
# cannot be trusted.
#
# Usage: collect_vc_runtime_data <pod> <node> <vc_path>
collect_vc_runtime_data() {
    local pod="$1"
    local node="$2"
    local vc_path="${3%/}"

    local staging
    local mktemp_rc
    staging=$(mktemp -d /tmp/osc-must-gather-vc-XXXXXX)
    mktemp_rc=$?
    if [[ $mktemp_rc -ne 0 ]]; then
        log_error "Creating staging directory for sandboxed containers runtime data for node $node" \
                  "mktemp -d /tmp/osc-must-gather-vc-XXXXXX" \
                  "$mktemp_rc" \
                  ""
        return 1
    fi

    # Capture the status directly: "if ! cmd; then ... $?" would always
    # see the negated status (0), losing the real failure/timeout code.
    local cp_rc=0
    local output
    output=$(exec_with_retry oc cp "$pod:/host/run/vc/" "${staging}/" -n node-gather 2>&1) || cp_rc=$?
    if [[ $cp_rc -ne 0 ]]; then
        log_error "Copying sandboxed containers runtime data for node $node" \
                  "oc cp $pod:/host/run/vc/ ${staging} -n node-gather" \
                  "$cp_rc" \
                  "$output"
        # The copy failed: drop the partial tree and publish nothing.
        rm -rf "${staging}"
        return 1
    fi

    # persist.json carries the sandbox process token, which leaktk flags
    # in the gathered archive (KATA-6494); redact before publishing.
    local redact_rc=0
    redact_token_fields "${staging}" || redact_rc=$?
    if [[ $redact_rc -ne 0 ]]; then
        # The data could not be sanitized: drop it. It lives outside the
        # collection tree, so even a failed removal cannot package
        # unredacted tokens (KATA-6494).
        rm -rf "${staging}"
        log_error "Redacting tokens in sandboxed containers runtime data for node $node" \
                  "redact_token_fields ${staging}" \
                  "$redact_rc" \
                  ""
        return 1
    fi

    # Publish the sanitized data; a failed publish also keeps the data out
    # of the archive.
    local publish_rc=0
    mkdir -p "$(dirname "${vc_path}")"
    mv "${staging}" "${vc_path}" || publish_rc=$?
    if [[ $publish_rc -ne 0 ]]; then
        rm -rf "${staging}"
        log_error "Publishing sandboxed containers runtime data for node $node" \
                  "mv ${staging} ${vc_path}" \
                  "$publish_rc" \
                  ""
        return 1
    fi
    return 0
}
